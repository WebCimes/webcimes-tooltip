{
    "name": "webcimes-tooltip",
    "version": "3.1.1",
    "description": "Create and animate tooltips simply, for dropdowns tooltips from button and titles tooltips. It works with vanilla javascript + html + css and with floating-ui dependency.",
    "main": "./dist/js/webcimes-tooltip.udm.js",
    "module": "./dist/js/webcimes-tooltip.esm.js",
    "types": "./src/ts/webcimes-tooltip.d.ts",
    "scripts": {
        "build": "tsc --emitDeclarationOnly && vite build",
        "watch": "vite build --watch",
        "dev": "vite"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebCimes/webcimes-tooltip.git"
    },
    "author": "WebCimes",
    "license": "MIT",
    "keywords": [
        "tooltip",
        "dropdown",
        "title"
    ],
    "bugs": {
        "url": "https://github.com/WebCimes/webcimes-tooltip/issues"
    },
    "homepage": "https://github.com/WebCimes/webcimes-tooltip#readme",
    "dependencies": {
        "@floating-ui/dom": "^1.5.3"
    },
    "devDependencies": {
        "lightningcss": "^1.33.0",
        "prettier": "^3.6.2",
        "typescript": "^5.2.2",
        "vite": "^8.3.8"
    }
}
